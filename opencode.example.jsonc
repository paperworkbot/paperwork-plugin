{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "paperwork": {
      "type": "remote",
      "url": "https://your-paperwork-host.example/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:PAPERWORK_MCP_TOKEN}"
      }
    }
  }
}
